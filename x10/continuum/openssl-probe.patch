+        if ((which & (SSL3_CC_READ | SSL3_CC_WRITE)) == SSL3_CC_READ)
+            x10_probe_key_event(s, 0, 1);
+        else if ((which & (SSL3_CC_READ | SSL3_CC_WRITE)) == SSL3_CC_WRITE)
+            x10_probe_key_event(s, 1, 1);
+        else
