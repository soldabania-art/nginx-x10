 typedef struct cert_pkey_st CERT_PKEY;
 
 struct ssl_st {
+    /* X10 C2a research monitor: metadata only, no key material.
+     * Bits 0/1 mean initial read/write application keys were observed.
+     * Bit 2 is sticky invalid history/overflow. SSL_clear does not reset it:
+     * a fresh SSL object is required by the supported profile. */
+    uint64_t x10_probe_read_generation;
+    uint64_t x10_probe_write_generation;
+    uint64_t x10_probe_mutation_serial;
+    unsigned int x10_probe_known;
     /*
      * protocol version (one of SSL2_VERSION, SSL3_VERSION, TLS1_VERSION,
      * DTLS1_VERSION)
      */
diff --git a/ssl/tls13_enc.c b/ssl/tls13_enc.c
--- a/ssl/tls13_enc.c
+++ b/ssl/tls13_enc.c
@@ -397,8 +397,35 @@
         return 0;
     }
 
     return 1;
+}
+
+/* Successful application-key events only. Never affects TLS success/failure.
+ * Unknown history, duplicate initial install or uint64 exhaustion is sticky.
+ * Initial generation is zero; KeyUpdate increments just its own direction. */
+static void x10_probe_key_event(SSL *s, int sending, int initial)
+{
+    unsigned int bit = sending ? 2U : 1U;
+    uint64_t *generation = sending ? &s->x10_probe_write_generation
+                                   : &s->x10_probe_read_generation;
+
+    if ((s->x10_probe_known & ~3U) != 0)
+        return;
+    if (s->x10_probe_mutation_serial == UINT64_MAX
+            || (initial && (s->x10_probe_known & bit) != 0)
+            || (!initial && ((s->x10_probe_known & bit) == 0
+                             || *generation == UINT64_MAX))) {
+        s->x10_probe_known |= 4U;
+        return;
+    }
+    if (initial) {
+        *generation = 0;
+        s->x10_probe_known |= bit;
+    } else {
+        ++*generation;
+    }
+    ++s->x10_probe_mutation_serial;
 }
 
 int tls13_change_cipher_state(SSL *s, int which)
 {
